using System.Reflection.Emit;

namespace Choose_a_weapon
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            string weapon = comboBox1.Text;

            switch (weapon)
            {
                case "Sword":
                    label2.Text = "⚔️ You attacked with a Sword!";
                    break;

                case "Bow":
                    label2.Text = "🏹 You attacked with a Bow!";
                    break;

                case "Magic":
                    label2.Text = "✨ You cast a Magic Spell!";
                    break;

                default:
                    label2.Text = "Select a weapon first!";
                    break;
            }
        }
    }
}


