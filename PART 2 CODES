namespace _2._Monster_Battle
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            int hp = 50;
            string result = "";

            do
            {
                hp -= 10;
                result += "Monster HP: " + hp + "\n";
            }
            while (hp > 0);

            result += "\nMonster Defeated!";
            label2.Text = result;
        }
    }
}


