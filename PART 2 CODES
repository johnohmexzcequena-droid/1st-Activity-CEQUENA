using System.Reflection.Emit;

namespace Choose_a_weapon
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            if (!int.TryParse(textBox1.Text, out int door))
            {
                label4.Text = "Enter a valid door number!";
                return;
            }

            switch (door)
            {
                case 1:
                    label4.Text = "💰 You found treasure!";
                    break;

                case 2:
                    label4.Text = "👾 A monster appeared!";
                    break;

                case 3:
                    label4.Text = "🧪 You found a magic potion!";
                    break;

                default:
                    label4.Text = "Choose Door 1, 2, or 3.";
                    break;
            }
        }
    }
}


